# Testnets only. Export these in your shell (hardhat.config.ts reads process.env; it does not load .env files):
#   set -a; source .env; set +a      # if you keep a local .env (git-ignored; never commit it)
# RPC endpoint of a TESTNET (e.g. Base Sepolia, Arbitrum Sepolia, Avalanche Fuji)
RPC_URL=
# Deployer key of a throwaway testnet account. NEVER a mainnet key.
PRIVATE_KEY=
# Optional
CHAIN_ID=
# Optional overrides for scripts/deploy.ts (see README "Deploy")
ADMIN_ADDRESS=
SIGNER_ADDRESS=
PAUSER_ADDRESS=
BURNER_ADDRESS=
TREASURY_ADDRESS=
GENESIS_AMOUNT=
WETH_ADDRESS=
SEED_POOLS=
SEED_SCALE=
