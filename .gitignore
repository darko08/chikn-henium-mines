# build output: `node build.mjs` recreates it, and the published copy lives on the gh-pages branch
dist/
node_modules/
# the original Runway sheets (313 MB) stay out of git; the cut sprites (assets/sprites) and the compressed
# images the build uses (assets/web) are committed
assets/raw/
# signed Runway URLs (they contain access tokens): never commit
tools/runway-refs.txt
# secrets
.env
.env.*
!.env.example
.DS_Store
# music: only the tracks the game plays are committed (the other candidates stay in the Runway library)
assets/music/*.mp3
!assets/music/main-theme.mp3
!assets/music/playful-mines-2.mp3
!assets/music/playful-farm-2.mp3
!assets/music/playful-factories.mp3
